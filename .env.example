# Copy to .env and fill in. The API runs arbitrary agent code — keep the token secret.

# --- HTTP control plane ----------------------------------------------------
# Bearer token required on every /v1/* request. Generate one, e.g.:
#   openssl rand -hex 32
API_AUTH_TOKEN=
API_PORT=8080

# Per-job limits.
JOB_TIMEOUT_SECONDS=1800
MAX_OUTPUT_BYTES=2000000

# --- Local models (Ollama on the GPU) --------------------------------------
ENABLE_OLLAMA=true
OLLAMA_PORT=11434

# --- Optional: Claude Code headless token ----------------------------------
# Instead of an interactive `agent-login claude`, you can paste a token from
# `claude setup-token` here (subscription accounts). Leave blank to use the
# interactive login flow that persists under the /data volume.
# CLAUDE_CODE_OAUTH_TOKEN=
